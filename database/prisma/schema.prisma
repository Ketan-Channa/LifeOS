generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  age                 Int?
  dob                 String?
  sex                 String?
  bloodGroup          String?
  email               String               @unique
  phone               String?
  password            String
  passwordHash        String
  securityQuestion    String?
  securityAnswer      String?
  avatarUrl           String?
  timezone            String               @default("UTC")
  currentPlan         String               @default("FREE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  tasks               Task[]
  goals               Goal[]
  scheduleEvents      ScheduleEvent[]
  habits              Habit[]
  habitLogs           HabitLog[]
  notes               Note[]
  aiInteractions      AIInteraction[]
  aiRecommendations   AIRecommendation[]
  aiPlanHistories     AIPlanHistory[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  knowledgeHistories  KnowledgeDocumentHistory[]
  scoutConversations  ScoutConversation[]
  scoutMessages       ScoutMessage[]
  scoutToolExecutions ScoutToolExecution[]
  scoutPredictions    ScoutPredictionOutcome[]
  agentRuns           AgentRun[]
  agentSettings       AgentSettings?
  agentMemories       AgentMemory[]
  agentConstraints    AgentConstraint[]
  agentActionLogs     AgentActionLog[]
  notifications       Notification[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model Subscription {
  id             String   @id @default(uuid())
  userId         String
  planName       String
  amount         Float
  currency       String   @default("INR")
  status         String   @default("ACTIVE")
  razorpayId     String?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum EventType {
  TASK
  CLASS
  WORK
  PERSONAL
  MEETING
  EXERCISE
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  WEEKDAYS
  CUSTOM
}

enum HabitLogStatus {
  COMPLETED
  PARTIAL
  MISSED
  SKIPPED
}

model Task {
  id                String          @id @default(uuid())
  userId            String
  goalId            String?
  milestoneId       String?
  title             String
  description       String?         @db.Text
  category          String          @default("General")
  priority          Priority        @default(MEDIUM)
  status            TaskStatus      @default(TODO)
  dueDate           DateTime?
  estimatedMinutes  Int             @default(30)
  actualMinutes     Int             @default(0)
  energyLevel       EnergyLevel     @default(MEDIUM)
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  createdAt         DateTime        @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal              Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  taskHistories     TaskHistory[]
  scheduleEvents    ScheduleEvent[]

  @@index([userId])
  @@index([goalId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskHistory {
  id              String   @id @default(uuid())
  taskId          String
  action          String
  previousStatus  String?
  newStatus       String?
  previousDueDate DateTime?
  newDueDate      DateTime?
  timestamp       DateTime @default(now())
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_histories")
}

model Goal {
  id             String          @id @default(uuid())
  userId         String
  title          String
  description    String?         @db.Text
  category       String          @default("General")
  priority       Priority        @default(MEDIUM)
  startDate      DateTime        @default(now())
  targetDate     DateTime?
  progress       Float           @default(0.0)
  status         GoalStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones     Milestone[]
  tasks          Task[]
  goalHistories  GoalHistory[]
  scheduleEvents ScheduleEvent[]
  habits         Habit[]

  @@index([userId])
  @@index([status])
  @@map("goals")
}

model Milestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  description String?   @db.Text
  order       Int       @default(1)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("milestones")
}

model GoalHistory {
  id               String   @id @default(uuid())
  goalId           String
  action           String
  previousProgress Float?
  newProgress      Float?
  previousStatus   String?
  newStatus        String?
  timestamp        DateTime @default(now())
  goal             Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_histories")
}

model ScheduleEvent {
  id                String            @id @default(uuid())
  userId            String
  title             String
  description       String?           @db.Text
  type              EventType         @default(OTHER)
  startTime         DateTime
  endTime           DateTime
  priority          Priority          @default(MEDIUM)
  location          String?
  isAllDay          Boolean           @default(false)
  recurrenceRule    String?
  reminderMinutes   Int?
  linkedTaskId      String?
  linkedGoalId      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedTask        Task?             @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  linkedGoal        Goal?             @relation(fields: [linkedGoalId], references: [id], onDelete: SetNull)
  scheduleHistories ScheduleHistory[]

  @@index([userId])
  @@index([startTime])
  @@index([linkedTaskId])
  @@index([linkedGoalId])
  @@map("schedule_events")
}

model ScheduleHistory {
  id                String        @id @default(uuid())
  eventId           String
  action            String
  previousStartTime DateTime?
  newStartTime      DateTime?
  previousEndTime   DateTime?
  newEndTime       DateTime?
  timestamp         DateTime      @default(now())
  event             ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("schedule_histories")
}

model Habit {
  id              String         @id @default(uuid())
  userId          String
  goalId          String?
  name            String
  description     String?        @db.Text
  category        String         @default("Personal")
  frequency       Frequency      @default(DAILY)
  customDays      String?
  targetValue     Float          @default(1.0)
  targetUnit      String         @default("session")
  preferredTime   String?
  priority        Priority       @default(MEDIUM)
  startDate       DateTime       @default(now())
  reminderMinutes Int?
  isActive        Boolean        @default(true)
  currentStreak   Int            @default(0)
  longestStreak   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  habitLogs       HabitLog[]
  habitHistories  HabitHistory[]

  @@index([userId])
  @@index([goalId])
  @@index([isActive])
  @@map("habits")
}

model HabitLog {
  id          String         @id @default(uuid())
  habitId     String
  userId      String
  date        String
  status      HabitLogStatus @default(COMPLETED)
  value       Float          @default(1.0)
  targetValue Float          @default(1.0)
  completedAt DateTime?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  habit       Habit          @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId])
  @@index([date])
  @@map("habit_logs")
}

model HabitHistory {
  id        String   @id @default(uuid())
  habitId   String
  action    String
  metadata  String?  @db.Text
  timestamp DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@map("habit_histories")
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   @db.Text
  category  String   @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notes")
}

model AIInteraction {
  id        String   @id @default(uuid())
  userId    String
  message   String   @db.Text
  response  String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_interactions")
}

model AIRecommendation {
  id              String   @id @default(uuid())
  userId          String
  type            String
  title           String
  reason          String   @db.Text
  priority        Priority @default(MEDIUM)
  suggestedAction String?
  applied         Boolean  @default(false)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_recommendations")
}

model AIPlanHistory {
  id        String   @id @default(uuid())
  userId    String
  date      String
  planName  String
  planScore Int      @default(80)
  planData  String   @db.Text
  selected  Boolean  @default(false)
  applied   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("ai_plan_histories")
}

enum ProcessingStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model KnowledgeDocument {
  id               String                   @id @default(uuid())
  userId           String
  title            String
  originalFileName String
  fileType         String
  fileSize         Int
  category         String                   @default("General")
  description      String?                  @db.Text
  tags             String?                  @db.Text // Comma-separated or JSON
  storagePath      String
  processingStatus ProcessingStatus         @default(UPLOADED)
  pageCount        Int                      @default(1)
  wordCount        Int                      @default(0)
  errorMessage     String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks           KnowledgeChunk[]
  history          KnowledgeDocumentHistory[]

  @@index([userId])
  @@index([category])
  @@index([processingStatus])
  @@index([createdAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  userId     String
  chunkIndex Int
  content    String            @db.Text
  tokenCount Int               @default(0)
  metadata   String?           @db.Text // JSON: pageNumber, section, heading
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@map("knowledge_chunks")
}

model KnowledgeDocumentHistory {
  id         String            @id @default(uuid())
  documentId String
  userId     String
  action     String // UPLOADED, PROCESSING_STARTED, PROCESSING_COMPLETED, PROCESSING_FAILED, UPDATED, DELETED, QUERIED
  timestamp  DateTime          @default(now())
  metadata   String?           @db.Text
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@map("knowledge_document_histories")
}

model ScoutConversation {
  id             String               @id @default(uuid())
  userId         String
  title          String               @default("New Conversation")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ScoutMessage[]
  toolExecutions ScoutToolExecution[]

  @@index([userId])
  @@index([createdAt])
  @@map("scout_conversations")
}

enum ScoutRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

model ScoutMessage {
  id             String            @id @default(uuid())
  conversationId String
  userId         String
  role           ScoutRole         @default(USER)
  content        String            @db.Text
  intent         String?           @default("GENERAL_QUERY")
  sources        String?           @db.Text // JSON string of sources
  actions        String?           @db.Text // JSON string of proposed/executed actions
  createdAt      DateTime          @default(now())
  conversation   ScoutConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
  @@map("scout_messages")
}

model ScoutToolExecution {
  id                   String            @id @default(uuid())
  conversationId       String
  userId               String
  toolName             String
  input                String            @db.Text // JSON string
  outputSummary        String?           @db.Text // JSON summary
  status               String            @default("COMPLETED") // PENDING, COMPLETED, CANCELLED, FAILED
  requiresConfirmation Boolean           @default(false)
  confirmed            Boolean           @default(false)
  createdAt            DateTime          @default(now())
  conversation         ScoutConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([toolName])
  @@map("scout_tool_executions")
}

model ScoutPredictionOutcome {
  id            String   @id @default(uuid())
  userId        String
  targetType    String   // TASK_RISK, GOAL_RISK, WORKLOAD_RISK, PRODUCTIVITY_FORECAST
  targetId      String
  predictedRisk Float
  actualOutcome String   // COMPLETED_ON_TIME, DELAYED, POSTPONED, MISSED
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetType])
  @@index([targetId])
  @@map("scout_prediction_outcomes")
}

model AgentRun {
  id             String      @id @default(uuid())
  userId         String
  conversationId String?
  objective      String      @db.Text
  intent         String      @default("PLAN")
  status         String      @default("IDLE") // IDLE, OBSERVING, PLANNING, WAITING_FOR_APPROVAL, EXECUTING, EVALUATING, COMPLETED, FAILED, CANCELLED
  autonomyLevel  String      @default("AUTONOMY_2")
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  result         String?     @db.Text
  error          String?     @db.Text
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps          AgentStep[]
  actionLogs     AgentActionLog[]

  @@index([userId])
  @@index([status])
  @@map("agent_runs")
}

model AgentStep {
  id               String    @id @default(uuid())
  agentRunId       String
  stepNumber       Int
  stepType         String    // OBSERVE, PLAN, TOOL_CALL, EVALUATE, USER_APPROVAL
  description      String
  toolName         String?
  inputSummary     String?   @db.Text
  outputSummary    String?   @db.Text
  status           String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, SKIPPED
  requiresApproval Boolean   @default(false)
  approved         Boolean   @default(false)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  agentRun         AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([stepNumber])
  @@map("agent_steps")
}

model AgentSettings {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  autonomyLevel                String   @default("AUTONOMY_2") // AUTONOMY_0 to AUTONOMY_4
  allowLowRiskActions          Boolean  @default(false)
  allowTaskCreation            Boolean  @default(true)
  allowScheduleChanges         Boolean  @default(false)
  allowGoalChanges             Boolean  @default(false)
  allowNotifications           Boolean  @default(true)
  requireConfirmationForWrites Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_settings")
}

model AgentMemory {
  id         String   @id @default(uuid())
  userId     String
  type       String   @default("PREFERENCE") // PREFERENCE, WORKFLOW, USER_DEFINED, IMPORTANT_CONTEXT
  key        String
  value      String   @db.Text
  source     String   @default("USER_EXPLICIT")
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("agent_memories")
}

model AgentConstraint {
  id        String   @id @default(uuid())
  userId    String
  type      String   // NO_EARLY_MORNING, MAX_DAILY_WORKLOAD, FIXED_EVENT, PREFERRED_FOCUS_WINDOW, GOAL_PRIORITY
  value     String   @db.Text
  priority  String   @default("MEDIUM")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
  @@map("agent_constraints")
}

model AgentActionLog {
  id         String   @id @default(uuid())
  userId     String
  agentRunId String?
  actionType String
  targetType String?
  targetId   String?
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  status     String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED, UNDONE
  confirmed  Boolean  @default(true)
  reversible Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agentRunId])
  @@map("agent_action_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @default("GENERAL") // TASK_DUE, TASK_OVERDUE, GOAL_RISK, SCHEDULE_CONFLICT, HABIT_REMINDER, PRODUCTIVITY_INSIGHT, AI_RECOMMENDATION, SYSTEM, SUBSCRIPTION, AGENT_ACTION, GENERAL
  title     String
  message   String    @db.Text
  priority  String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  isRead    Boolean   @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}




