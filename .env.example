# ============================================================
# LifeOS Production Environment Configuration Template (.env.example)
# Placeholders only — DO NOT commit real secrets to Git
# ============================================================

# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/lifeos_db"

# Express Backend Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL="http://localhost:5173"

# JWT Authentication
JWT_SECRET="YOUR_SUPER_SECRET_JWT_SIGNING_KEY_CHANGE_IN_PRODUCTION"
JWT_EXPIRES_IN="7d"

# Python AI Microservice Engine
PYTHON_AI_SERVICE_URL="http://127.0.0.1:8000"

# Gemini AI API Key
GEMINI_API_KEY="YOUR_GOOGLE_GEMINI_1_5_PRO_API_KEY"

# RAG & Vector Knowledge Base
VECTOR_DB_PATH="./vector_store_data"

# Subscription & Payment Gateway
PAYMENT_SECRET="YOUR_RAZORPAY_OR_STRIPE_PRODUCTION_SECRET"

# Email Reset Provider (Optional)
EMAIL_SERVICE_API_KEY="YOUR_SENDGRID_OR_MAILGUN_API_KEY"
