# ============================================================
# LifeOS Git Ignore
# ============================================================

# -------------------- Node / JavaScript --------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# -------------------- Environment / Secrets ----------------
.env
.env.*
!.env.example

# -------------------- Build Outputs ------------------------
dist/
build/
.vite/
coverage/
.cache/
.tmp/
temp/

# -------------------- Python / AI Service ------------------
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# -------------------- Prisma / Local Database --------------
database/prisma/*.db
database/prisma/*.db-journal

# -------------------- Storage / User Generated Data -------
storage/*
!storage/.gitkeep

uploads/
*.sqlite
*.sqlite3

# -------------------- IDE ----------------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------- OS -----------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------- Temporary Files ---------------------
*.tmp
*.temp
*.bak
*.old

# -------------------- Generated Files ----------------------
*.pid
*.seed
*.cache

# -------------------- Python Generated ---------------------
*.egg-info/
.pytest_cache/

# -------------------- Secrets / Certificates ---------------
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# -------------------- Vercel -------------------------------
.vercel/

# -------------------- Misc ---------------------------------
.DS_Store
